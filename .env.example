# Copy to .env.local and fill in. Never commit real values.
# Real values live in Vercel (Project → Settings → Environment Variables).
PUBLIC_SITE_URL=

# --- Forms: Google Sheets and email (Phase 5) -------------------------------
# Without these three, forms run in "log" mode outside production: rows and
# emails are printed to the server log instead. Production refuses to run
# without them.
# A service account from Google Cloud; share the Sheet with its email as Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# The account's private key. In Vercel paste it as is; in .env.local keep it on
# one line with \n for each line break, in double quotes.
GOOGLE_PRIVATE_KEY=
# From the Sheet's URL: docs.google.com/spreadsheets/d/<this part>/edit
GOOGLE_SHEET_ID=

# Email is sent through Gmail as this Workspace user, via the service account's
# domain-wide delegation (Workspace admin: Security → API controls →
# Domain-wide delegation, scope https://www.googleapis.com/auth/gmail.send).
# Without it, emails are logged instead of sent (and production refuses to run).
GMAIL_DELEGATED_USER=
MAIL_FROM=info@dandelionclub.co.za
MAIL_NOTIFY=info@dandelionclub.co.za

# --- Spam protection: Cloudflare Turnstile ---------------------------------
# Cloudflare's published test keys always pass; use them until the real ones exist:
#   TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# The site key is read at build time, so redeploy after changing it.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Payments: PayFast (Phase 6) -------------------------------------------
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true

PLAUSIBLE_DOMAIN=dandelionclub.co.za
