---
/** "The Dandelion idea": one line on night with a few short lines under it. A source shows only when there is one. */
import Section from './Section.astro';
import { isTodo } from '../lib/todo';

interface Props {
  fact?: { text: string; lines?: string[]; sourceUrl?: string };
}

const { fact } = Astro.props;
const show = fact && !isTodo(fact.text);
const source = fact?.sourceUrl && !isTodo(fact.sourceUrl) ? fact.sourceUrl : undefined;
---

{show && (
  <Section ground="night" aria-labelledby="fact-eyebrow">
    <figure class="fact">
      <p class="t-eyebrow muted" id="fact-eyebrow">
        The Dandelion idea
      </p>
      <blockquote class="fact__text">
        <p>{fact.text}</p>
      </blockquote>
      {fact.lines && fact.lines.length > 0 && (
        <div class="fact__lines t-lead on-night">
          {fact.lines.map((line) => (
            <p>{line}</p>
          ))}
        </div>
      )}
      {source && (
        <figcaption class="t-small muted">
          Source: <a href={source}>{new URL(source).hostname}</a>
        </figcaption>
      )}
    </figure>
  </Section>
)}

<style>
  .fact {
    display: grid;
    gap: var(--space-4);
  }

  .fact__lines {
    display: grid;
    gap: var(--space-2);
    max-width: var(--measure-text);
  }

  .fact__text {
    font-family: var(--type-display-family);
    font-weight: var(--type-display-weight);
    font-size: var(--type-display-sm-size);
    line-height: var(--type-display-sm-leading);
    text-transform: uppercase;
    color: var(--dandelion);
  }

  @media (min-width: 600px) {
    .fact__text {
      font-size: var(--type-display-size);
      line-height: var(--type-display-leading);
    }
  }
</style>
