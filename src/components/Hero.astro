---
/**
 * Page opening on night: a site photograph fading into night, then eyebrow,
 * dandelion display headline, supporting lines and one or two actions.
 * Text never sits on the photograph. See design/components/Hero.md.
 *
 * Slots: "kicker" = a line above the eyebrow (e.g. a back link),
 * default = supporting lines (lead), "actions" = Buttons.
 */
import type { ImageMetadata } from 'astro';
import PhotoBand from './PhotoBand.astro';
import RiveSlot from './RiveSlot.astro';

interface Props {
  eyebrow?: string;
  /** Two to four words, sentence case. */
  headline: string;
  image?: ImageMetadata;
  imageAlt?: string;
  /** CSS object-position for the photo crop. */
  imagePosition?: string;
  /** The h1 by default: a hero opens the page. */
  level?: 1 | 2;
}

const { eyebrow, headline, image, imageAlt = '', imagePosition, level = 1 } = Astro.props;
const Heading = `h${level}` as 'h1' | 'h2';
---

<section class="hero on-night">
  {image ? (
    <PhotoBand image={image} alt={imageAlt} position={imagePosition} />
  ) : (
    <div class="hero__media">
      <RiveSlot class="hero__stand-in" src="/brand/seed-yellow.svg" width={106} height={134} />
    </div>
  )}
  <div class="container hero__body">
    <div class="hero__text">
      {Astro.slots.has('kicker') && <slot name="kicker" />}
      {eyebrow && <p class="t-eyebrow">{eyebrow}</p>}
      <Heading class="t-display-xl hero__headline">{headline}</Heading>
      <div class="hero__lines t-lead">
        <slot />
      </div>
    </div>
    {Astro.slots.has('actions') && (
      <div class="hero__actions">
        <slot name="actions" />
      </div>
    )}
  </div>
</section>

<style>
  .hero__media {
    position: relative;
    aspect-ratio: 3 / 2;
    background: var(--night-raised);
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  .hero__media :global(.hero__stand-in) {
    width: var(--seed-size-sm);
  }

  .hero__body {
    display: grid;
    gap: var(--space-5);
    padding-block: var(--space-2) var(--space-9);
  }

  .hero__text {
    display: grid;
    gap: var(--space-5);
  }

  .hero__headline {
    color: var(--dandelion);
  }

  .hero__lines {
    display: grid;
    gap: var(--space-5);
    max-width: var(--measure-text);
  }

  .hero__actions {
    display: grid;
    gap: var(--space-3);
  }

  .hero__actions :global(.btn) {
    width: 100%;
  }

  /* One action fits its label instead of filling the row. */
  .hero__actions:has(> :only-child) {
    justify-items: start;
  }

  .hero__actions:has(> :only-child) :global(.btn) {
    width: auto;
  }

  @media (min-width: 768px) {
    .hero__media {
      aspect-ratio: 3 / 1;
    }

    .hero__media :global(.hero__stand-in) {
      width: var(--seed-size);
    }

    .hero__actions {
      justify-items: start;
    }

    .hero__actions :global(.btn) {
      width: auto;
    }
  }

  @media (min-width: 1024px) {
    .hero__body {
      grid-template-columns: 2fr 1fr;
      align-items: end;
      column-gap: var(--space-7);
      padding-block: var(--space-4) var(--space-10);
    }

    .hero__actions {
      justify-items: end;
    }
  }
</style>
