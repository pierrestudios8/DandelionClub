---
/** A journal post as a whole-card link: photo, tag, title, date and author. */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Placeholder from './Placeholder.astro';

interface Props {
  title: string;
  href: string;
  date: string;
  author: string;
  tag: string;
  image?: ImageMetadata;
}

const { title, href, date, author, tag, image } = Astro.props;
---

<a class="post" href={href}>
  <div class="post__media">
    {image && <Image src={image} alt="" widths={[220, 440]} sizes="220px" />}
  </div>
  <div class="post__text">
    <span class="post__tag">{tag}</span>
    <h3 class="post__title">{title}</h3>
    <p class="t-small muted">
      {date} · <Placeholder value={author} />
    </p>
  </div>
</a>

<style>
  .post {
    display: grid;
    gap: var(--space-4);
    color: var(--night);
    text-decoration: none;
  }

  .post:hover .post__title {
    text-decoration: underline;
    text-decoration-thickness: var(--border-strong);
  }

  .post__media {
    aspect-ratio: 11 / 9;
    background: var(--paper-sunk);
    border: var(--border-strong) solid var(--night);
    overflow: hidden;
  }

  .post__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .post__text {
    display: grid;
    gap: var(--space-2);
    align-content: start;
  }

  .post__tag {
    justify-self: start;
    padding: var(--space-1) var(--space-2);
    background: var(--night);
    color: var(--dandelion);
    font-family: var(--type-tag-family);
    font-size: var(--type-tag-size);
    line-height: var(--type-tag-leading);
    font-weight: var(--type-tag-weight);
    text-transform: uppercase;
  }

  .post__title {
    font-size: var(--type-subtitle-size);
    line-height: var(--type-subtitle-leading);
    font-weight: var(--type-subtitle-weight);
  }

  @media (min-width: 600px) {
    .post {
      grid-template-columns: 2fr 3fr;
      gap: var(--space-5);
    }
  }
</style>
