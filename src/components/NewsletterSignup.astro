---
/**
 * Inline email + button used in the footer and on the Plantings, Get involved
 * and Home pages. Posts to the newsletter endpoint (stubbed in Phase 3, wired
 * in Phase 5). The POPIA consent line sits under the field.
 */
import Button from './Button.astro';
import Form from './Form.astro';

interface Props {
  id: string;
  /** Visible heading above the form; also its accessible name. Omit when the section has one. */
  label?: string;
  /** Id of an existing heading to name the form by, instead of `label`. */
  labelledBy?: string;
  button?: string;
}

const { id, label = 'Hear about the next planting', labelledBy, button = 'Sign up' } = Astro.props;
const headingId = labelledBy ?? `${id}-heading`;
---

<div class="signup">
  <Form
    id={id}
    action="/api/newsletter"
    aria-labelledby={headingId}
    successTitle="You're on the list."
  >
    {!labelledBy && (
      <p class="t-eyebrow-sm signup__heading" id={headingId}>
        {label}
      </p>
    )}
    <div class="signup__field" data-field>
      <div class="signup__row">
        <label class="visually-hidden" for={`${id}-email`}>
          Email address
        </label>
        <input
          class="signup__input"
          id={`${id}-email`}
          name="email"
          type="email"
          autocomplete="email"
          placeholder="Your email"
          required
          data-invalid-message="Enter a full email address, like name@example.com."
        />
        <Button type="submit" compact>
          {button}
        </Button>
      </div>
      <p class="signup__error" id={`${id}-email-error`} hidden></p>
    </div>
    <div class="signup__field" data-field>
      <label class="signup__consent t-small" for={`${id}-consent`}>
        <input
          type="checkbox"
          id={`${id}-consent`}
          name="consent"
          value="yes"
          required
          data-invalid-message="Tick this box so we can email you."
        />
        <span>
          Dandelion Club may email me about plantings. <a href="/privacy">Privacy</a>
        </span>
      </label>
      <p class="signup__error" id={`${id}-consent-error`} hidden></p>
    </div>
    <p slot="success">We'll email you when the next planting date is set.</p>
  </Form>
</div>

<style>
  .signup :global(.form) {
    display: grid;
    gap: var(--space-3);
  }

  .signup__field {
    display: grid;
    gap: var(--space-2);
  }

  .signup__row {
    display: flex;
  }

  .signup__input {
    flex: 1 1 auto;
    min-width: 0;
    padding: var(--space-3) var(--space-4);
    font-size: var(--type-small-lg-size);
    line-height: var(--type-small-lg-leading);
    border: var(--border-strong) solid var(--night);
    border-right: 0;
    border-radius: var(--radius-none);
    background: var(--paper);
    color: var(--night);
  }

  .signup__input::placeholder {
    color: var(--ink-muted);
  }

  .signup__field[data-invalid] .signup__input {
    border-color: var(--error);
  }

  .signup__error {
    font-size: var(--type-small-size);
    line-height: var(--type-small-leading);
    font-weight: var(--type-lead-weight);
    color: var(--error);
  }

  .signup__consent {
    display: flex;
    gap: var(--space-2);
    align-items: flex-start;
  }

  .signup__consent input {
    flex: none;
    width: var(--space-4);
    height: var(--space-4);
    margin-top: var(--space-1);
    accent-color: var(--night);
  }

  :global(.on-night) .signup__heading {
    color: var(--dandelion);
  }

  :global(.on-night) .signup__input {
    background: var(--night-raised);
    color: var(--paper);
    border-color: var(--dandelion);
  }

  :global(.on-night) .signup__input::placeholder {
    color: var(--ink-muted-on-night);
  }

  :global(.on-night) .signup__consent {
    color: var(--ink-muted-on-night);
  }

  :global(.on-night) .signup__consent input {
    accent-color: var(--dandelion);
  }

  /* Error red fails contrast on night, so errors there use dandelion, with the words. */
  :global(.on-night) .signup__error {
    color: var(--dandelion);
  }

  :global(.on-night) .signup__field[data-invalid] .signup__input {
    border-color: var(--dandelion);
    outline: var(--border-strong) solid var(--dandelion);
    outline-offset: calc(var(--border-strong) * -1);
  }
</style>
