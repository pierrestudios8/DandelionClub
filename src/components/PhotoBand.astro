---
/**
 * Full-bleed photograph at the top of a night opening, fading into night at
 * the bottom (transparent at 42% → night at 100%). Text never sits on it.
 * Used by Hero and PageIntro.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  image: ImageMetadata;
  alt: string;
  /** CSS object-position. Centred by default. */
  position?: string;
  /** Band: full-bleed strip (3:2, 5:2 from 768px). Frame: a 4:3 photo inside a layout. */
  shape?: 'band' | 'frame';
  /** Load at once (page openings) or lazily (further down the page). */
  eager?: boolean;
  sizes?: string;
}

const {
  image,
  alt,
  position = 'center',
  shape = 'band',
  eager = true,
  sizes = shape === 'band' ? '100vw' : '(min-width: 1024px) 50vw, 100vw',
} = Astro.props;
---

<div class:list={['photo-band', `photo-band--${shape}`]}>
  <Image
    class="photo-band__img"
    src={image}
    alt={alt}
    widths={[390, 780, 1200, 1440, 2160]}
    sizes={sizes}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    style={`object-position: ${position}`}
  />
</div>

<style>
  .photo-band {
    position: relative;
    background: var(--night-raised);
    overflow: hidden;
  }

  .photo-band :global(.photo-band__img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .photo-band::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(transparent 42%, var(--night) 100%);
  }

  .photo-band--band {
    aspect-ratio: 3 / 2;
  }

  .photo-band--frame {
    aspect-ratio: 4 / 3;
  }

  @media (min-width: 768px) {
    .photo-band--band {
      aspect-ratio: 5 / 2;
    }
  }
</style>
