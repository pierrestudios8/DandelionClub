---
/** A site on night (Home, "Where we work"): photo, name, one line. The whole card links. */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Placeholder from './Placeholder.astro';

interface Props {
  name: string;
  summary: string;
  href: string;
  image?: ImageMetadata;
}

const { name, summary, href, image } = Astro.props;
---

<a class="site" href={href}>
  <div class="site__media">
    {image ? (
      <Image src={image} alt="" widths={[390, 780]} sizes="(min-width: 1024px) 33vw, 100vw" />
    ) : (
      <span class="t-small">Photo of {name} to come</span>
    )}
  </div>
  <h3 class="site__name">{name}</h3>
  <p class="t-small muted">
    <Placeholder value={summary} />
  </p>
</a>

<style>
  .site {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    color: var(--paper);
    text-decoration: none;
  }

  .site:hover .site__name {
    text-decoration: underline;
    text-decoration-thickness: var(--border-strong);
  }

  .site__media {
    aspect-ratio: 16 / 10;
    background: var(--night-raised);
    color: var(--ink-muted-on-night);
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  .site__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .site__name {
    font-size: var(--type-subtitle-sm-size);
    line-height: var(--type-subtitle-sm-leading);
    font-weight: var(--type-subtitle-sm-weight);
  }

  @media (min-width: 600px) {
    .site__name {
      font-size: var(--type-subtitle-size);
      line-height: var(--type-subtitle-leading);
    }
  }
</style>
