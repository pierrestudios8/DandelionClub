---
/** Get involved hub: design/pages/GetInvolved.dc.html. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import PageIntro from '../../components/PageIntro.astro';
import Pathways from '../../components/Pathways.astro';
import Section from '../../components/Section.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { getNextPlanting } from '../../lib/content';

const next = await getNextPlanting();
const joinHref = next ? `/plantings/${next.id}#sign-up` : '/plantings';
---

<BaseLayout
  title="Get involved"
  description="Plant with us, dedicate a tree, donate, propose a site or partner with Dandelion Club."
>
  <PageIntro eyebrow="Get involved" title="Find your way in.">
    Dandelion Club is designed to be participatory. You can spend one day with us or become part of
    building a food forest over several years.
  </PageIntro>

  <Section ground="paper" aria-label="Ways to get involved">
    <Pathways joinHref={joinHref} />
  </Section>

  <Section ground="night" aria-labelledby="not-ready">
    <div class="later">
      <SectionHeading eyebrow="Not ready yet?" id="not-ready">
        Hear about the next one.
      </SectionHeading>
      <NewsletterSignup id="get-involved-newsletter" labelledBy="not-ready" />
    </div>
  </Section>
</BaseLayout>

<style>
  .later {
    display: grid;
    gap: var(--space-7);
  }

  @media (min-width: 1024px) {
    .later {
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: var(--space-10);
    }
  }
</style>
