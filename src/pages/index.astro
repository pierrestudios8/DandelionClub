---
/** Home: design/pages/Home.dc.html (1440px) and HomeMobile.dc.html (390px). */
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import FactBand from '../components/FactBand.astro';
import Hero from '../components/Hero.astro';
import ImpactStrip from '../components/ImpactStrip.astro';
import NextPlanting from '../components/NextPlanting.astro';
import Placeholder from '../components/Placeholder.astro';
import RouteCard from '../components/RouteCard.astro';
import Section from '../components/Section.astro';
import SectionHeading from '../components/SectionHeading.astro';
import SeedBand from '../components/SeedBand.astro';
import SiteCard from '../components/SiteCard.astro';
import {
  getFacts,
  getImpactFigures,
  getNextPlanting,
  getProgrammes,
  getSettings,
  getSites,
  plantingCard,
} from '../lib/content';

const [next, figures, facts, programmes, sites, settings] = await Promise.all([
  getNextPlanting(),
  getImpactFigures(),
  getFacts(),
  getProgrammes(),
  getSites(),
  getSettings(),
]);
const nextCard = next ? await plantingCard(next) : undefined;
const joinHref = nextCard ? `${nextCard.href}#sign-up` : '/plantings';
const fact = facts[0]?.data;
---

<BaseLayout
  title="Dandelion Club"
  description="Dandelion Club turns underused community spaces in the Western Cape into food forests. Join a planting, dedicate a tree or donate."
>
  <Hero eyebrow="Food forests for stronger futures" headline="Plant it forward.">
    <p>
      We turn underused community spaces into thriving food forests: places that produce food,
      restore soil, build climate resilience, use water wisely, create economic opportunities,
      honour local knowledge and culture, and bring people together.
    </p>
    <p>
      We work with communities, government, businesses, restaurants and hotels, growers, funders and
      volunteers to plant living systems that become more productive, diverse and resilient over
      time.
    </p>
    <Fragment slot="actions">
      <Button href="/get-involved">Get involved</Button>
    </Fragment>
  </Hero>

  <NextPlanting planting={nextCard}>
    <p>
      A Dandelion Club planting day is part work, part party, part learning, part leading, part
      sharing and part community gathering.
    </p>
    <p>
      We bring the people together, trees, compost, mulch, tools, local food, music and a plan. You
      bring yourself.
    </p>
    <p>
      Together we transform another patch of ground into something that can feed people, teach
      skills and support a community for years to come.
    </p>
    <p>
      Bring gloves if you've got them.
      <br />
      We'll bring everything else.
    </p>
  </NextPlanting>

  <ImpactStrip figures={figures} />

  <Section
    ground={figures.treesPlanted !== null ? 'paper' : 'paper-sunk'}
    aria-labelledby="ways-heading"
  >
    <SectionHeading eyebrow="Ways in" id="ways-heading">
      Where do you fit?
    </SectionHeading>
    <div class="ways">
      <RouteCard
        href={joinHref}
        title="Join"
        audience="For anyone with a free Saturday"
        headingLevel={3}
      >
        Turn up, dig, plant. Everyone welcome. We bring the trees, compost, mulch, tools and a plan.
        You bring yourself.
      </RouteCard>
      <RouteCard
        opens="support-dialog"
        title="Support a food forest"
        audience="For teams, enterprises and individuals"
        headingLevel={3}
      >
        Pay for the soil, the trees and the care around them. Choose how you want to be part of it.
      </RouteCard>
    </div>
  </Section>
  <dialog class="support" id="support-dialog" aria-labelledby="support-title">
    <div class="support__bar">
      <h2 class="support__title" id="support-title">
        Support a food forest
      </h2>
      <button class="support__close" type="button" data-close>
        <span class="visually-hidden">Close</span>
        <span aria-hidden="true">×</span>
      </button>
    </div>
    <ul role="list" class="support__options">
      <li class="option">
        <h3 class="option__title">Corporate investment</h3>
        <p class="option__text">
          Bring your team for a planting day, or contribute financially without the day.
        </p>
        <Button href="/get-involved/partner">Talk to us</Button>
      </li>
      <li class="option">
        <h3 class="option__title">Enterprise development</h3>
        <p class="option__text">
          Back the nurseries, produce and small enterprises that grow around a food forest.
        </p>
        <Button href="/get-involved/partner">Talk to us</Button>
      </li>
      <li class="option">
        <h3 class="option__title">Individuals</h3>
        <p class="option__text">Put a name to a tree, or give once or monthly.</p>
        <div class="option__actions">
          <Button href="/dedicate-a-tree">Dedicate a tree</Button>
          <Button href="/donate">Donate</Button>
        </div>
      </li>
    </ul>
  </dialog>

  <FactBand fact={fact} />

  <Section ground="paper-sunk" aria-labelledby="work-heading" class="home-work">
    <div class="split-head">
      <SectionHeading eyebrow="What we do" id="work-heading">
        More than trees.
      </SectionHeading>
      <Button href="/our-work" variant="ghost">
        Our work
      </Button>
    </div>
    <div class="work-intro t-body">
      <p>A food forest is not simply an orchard. It is a living system.</p>
      <p>
        Indigenous and climate-appropriate trees create the protective canopy. Fruit and nut trees,
        shrubs, berries, vegetables and medicinal herbs create nourishment. Climbers, groundcovers
        and root crops fill the layers underneath. Compost feeds the soil. Mulch protects the
        system. Water is slowed and held. Organic waste becomes a resource. And communities benefit
        from the abundance of the ecosystem.
      </p>
    </div>
    <ul role="list" class="programmes">
      {programmes.map((p) => (
        <li class="programme">
          <h3 class="programme__title">{p.data.title}</h3>
          <p class="programme__summary muted">
            <Placeholder value={p.data.summary} />
          </p>
        </li>
      ))}
    </ul>
  </Section>

  <Section ground="paper" aria-labelledby="agro-heading">
    <div class="agro">
      <div class="agro__main">
        <SectionHeading eyebrow="How we work" id="agro-heading">
          Agroecology, made practical.
        </SectionHeading>
        <div class="t-body stack">
          <p>
            Dandelion Club works through an agroecological approach. That means looking beyond
            simply producing vegetables. We ask how food, water, soil, biodiversity, livelihoods,
            local knowledge and community ownership can support one another.
          </p>
          <p>
            Rather than importing a finished solution, we begin by understanding the place and the
            people already connected to it. Then we build from there.
          </p>
        </div>
        <Button href="/about#approach-heading">See how we work</Button>
      </div>
    </div>
  </Section>
  <Section ground="paper-sunk" aria-labelledby="observe-heading">
    <div class="observe">
      <SectionHeading eyebrow="Observe first" id="observe-heading">
        Start with what is already there.
      </SectionHeading>
      <div class="t-body stack observe__text">
        <p>
          Before we plant, we observe. Where does the water move? Where does the wind come from?
          What already grows? Who uses the space? What knowledge already exists in the community?
          What resources are being overlooked or thrown away?
        </p>
        <p>
          A good food forest doesn't begin with a planting plan. It begins with understanding the
          system.
        </p>
      </div>
    </div>
  </Section>
  {sites.length > 0 && (
    <Section ground="night" aria-labelledby="sites-heading">
      <SectionHeading eyebrow="Where we work" id="sites-heading">
        One food forest at a time.
      </SectionHeading>
      <div class="cards cards--three">
        {sites.map((s) => (
          <SiteCard
            name={s.data.name}
            summary={s.data.summary}
            href={`/sites/${s.id}`}
            image={s.data.heroImage}
          />
        ))}
      </div>
    </Section>
  )}

  <SeedBand />

  <Section ground="paper-sunk" aria-labelledby="funders-heading">
    <div class="funders">
      <div class="funders__text">
        <SectionHeading eyebrow="For funders and partners" id="funders-heading">
          Fund a planting day.
        </SectionHeading>
        <div class="t-body stack">
          <p>
            A Dandelion Club planting day can become much more than a once-off team activity. We
            work with corporate partners to shape days that bring together team building, cultural
            immersion, ecological learning, whole-systems thinking, leadership development and
            hands-on community participation.
          </p>
          <p>
            Each day is designed around both the needs of the sponsoring team and the needs of the
            local forest community. That might mean supporting a smaller Pocket Food Forest of
            around 21 trees, adding to an existing forest, helping establish a medium forest of
            around 88 trees, or contributing towards a full food-forest system that includes the
            support systems needed around it.
          </p>
          <p>
            The size and approach can change. The intention stays the same: to create something
            living that continues long after the planting day is over.
          </p>
          <p class="t-small muted">Dandelion Club is run by {settings.npcName}.</p>
        </div>
      </div>
      <div class="funders__actions">
        <Button href="/get-involved/partner">
          Bring your team into a living community project
        </Button>
      </div>
    </div>
  </Section>

  <Section ground="night" aria-labelledby="close-heading">
    <div class="close">
      <SectionHeading eyebrow="Get involved" id="close-heading" size="display-xl">
        Get your hands dirty.
      </SectionHeading>
      <div class="close__text on-night">
        <p class="t-lead">You don't need to be a gardener to be part of Dandelion Club.</p>
        <ul role="list" class="close__list t-body">
          <li>Follow our story.</li>
          <li>Join our newsletter.</li>
          <li>Dedicate a tree.</li>
          <li>Join a planting day.</li>
          <li>Offer skills.</li>
          <li>Bring a community site to us.</li>
          <li>Fund a food forest.</li>
        </ul>
        <p class="t-body">Help us create the conditions for the next one.</p>
      </div>
      <Button href="/get-involved" class="close__button">
        Find your way in
      </Button>
    </div>
  </Section>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLElement>('[data-opens]').forEach((trigger) => {
    const dialog = document.getElementById(trigger.dataset.opens ?? '') as HTMLDialogElement | null;
    if (!dialog) return;
    trigger.addEventListener('click', () => dialog.showModal());
    dialog.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
    // A click on the backdrop (outside the panel) closes it.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => trigger.focus());
  });
</script>

<style>
  .support {
    margin: auto;
    width: min(100% - var(--space-8), var(--measure-content));
    max-height: calc(100% - var(--space-8));
    padding: var(--space-7);
    background: var(--night-raised);
    color: var(--paper);
    border: var(--border-strong) solid var(--dandelion);
    border-radius: var(--radius-none);
    overflow-y: auto;
  }
  .support::backdrop {
    background: var(--night);
    opacity: 0.8;
  }
  .support__bar {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-7);
  }
  .support__title {
    font-family: var(--type-display-family);
    font-size: var(--type-display-sm-size);
    line-height: var(--type-display-sm-leading);
    font-weight: var(--type-display-weight);
    text-transform: uppercase;
    color: var(--dandelion);
  }
  .support__close {
    flex: none;
    width: var(--space-8);
    height: var(--space-8);
    background: var(--night-raised);
    color: var(--dandelion);
    border: var(--border-strong) solid var(--dandelion);
    border-radius: var(--radius-none);
    font-family: var(--font-display);
    font-size: var(--type-subtitle-size);
    cursor: pointer;
  }
  .support__options {
    display: grid;
    gap: var(--space-5);
  }
  .option {
    display: grid;
    gap: var(--space-4);
    align-content: start;
    padding: var(--space-5);
    border: var(--border-strong) solid var(--dandelion);
  }
  .option__title {
    font-family: var(--type-eyebrow-family);
    font-size: var(--type-eyebrow-size);
    line-height: var(--type-eyebrow-leading);
    font-weight: var(--type-eyebrow-weight);
    overflow-wrap: anywhere;
    text-transform: uppercase;
    color: var(--dandelion);
  }
  .option__text {
    font-size: var(--type-body-size);
    line-height: var(--type-body-leading);
  }
  .option__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  @media (min-width: 1024px) {
    .support__options {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .option__title {
      font-size: var(--type-eyebrow-lg-size);
      line-height: var(--type-eyebrow-lg-leading);
    }
  }
  .split-head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-5);
    margin-bottom: var(--space-8);
  }

  /* On phones the section's button moves out of the heading row, as in HomeMobile. */
  @media (max-width: 599px) {
    .split-head :global(.btn) {
      display: none;
    }
  }

  .work-intro {
    display: grid;
    gap: var(--space-4);
    max-width: var(--measure-text);
    margin-bottom: var(--space-8);
  }

  .ways {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-8);
  }
  .agro {
    display: grid;
    gap: var(--space-8);
  }
  .agro__main,
  .agro .stack {
    display: grid;
    gap: var(--space-4);
    align-content: start;
    max-width: var(--measure-text);
  }
  .agro__main :global(.btn) {
    justify-self: start;
  }
  .observe {
    display: grid;
    gap: var(--space-6);
  }
  .observe__text {
    display: grid;
    gap: var(--space-4);
    align-content: start;
    max-width: var(--measure-text);
  }

  .funders__text .stack,
  .close__text {
    display: grid;
    gap: var(--space-4);
  }

  .close :global(.close__button) {
    justify-self: start;
  }
  .close__list {
    display: grid;
    gap: var(--space-1);
  }

  .programmes {
    display: grid;
    gap: var(--space-7) var(--space-5);
  }

  .programme {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    padding-block: var(--space-4) var(--space-6);
    border-top: var(--border-strong) solid var(--night);
  }

  .programme__title {
    font-size: var(--type-subtitle-sm-size);
    line-height: var(--type-subtitle-sm-leading);
    font-weight: var(--type-subtitle-sm-weight);
  }

  .programme__summary {
    font-size: var(--type-small-size);
    line-height: var(--type-small-leading);
  }

  .cards {
    display: grid;
    gap: var(--space-7) var(--space-5);
    margin-top: var(--space-8);
  }

  .split-head + .cards {
    margin-top: 0;
  }

  .funders,
  .close {
    display: grid;
    gap: var(--space-7);
  }

  .funders__text {
    display: grid;
    gap: var(--space-4);
    max-width: var(--measure-text);
  }

  .funders__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  @media (min-width: 768px) {
    .programmes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .cards--two,
    .cards--three {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 768px) {
    .ways {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .observe {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-9);
      align-items: start;
    }
    .programmes,
    .cards--three {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .programme {
      gap: var(--space-4);
      padding-block: var(--space-5) var(--space-7);
    }

    .programme__title {
      font-size: var(--type-subtitle-size);
      line-height: var(--type-subtitle-leading);
    }

    .funders {
      grid-template-columns: 7fr 1fr 4fr;
      align-items: center;
    }

    .funders__actions {
      grid-column: 3;
      flex-direction: column;
      align-items: flex-end;
    }

    .close {
      grid-template-columns: 1fr auto;
      align-items: center;
    }
  }
</style>
